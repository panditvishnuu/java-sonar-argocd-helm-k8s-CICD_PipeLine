pipeline {
    agent {
        docker {
            image 'vishnu827/jenkins-java-sonar-cicd:latest'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        // Must match the image repo used in deployment.yml
        IMAGE_REPO    = 'vishnu827/jenkins-java-sonar-cicd'
        // WSL2 IP: changes after a WSL restart, update it if Sonar becomes unreachable
        SONAR_URL     = 'http://172.29.19.205:9000'
        APP_DIR       = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        MANIFEST      = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'
        GIT_REPO_NAME = 'java-sonar-argocd-helm-k8s-CICD_PipeLine'
        GIT_USER_NAME = 'panditvishnuu'
    }

    stages {
        stage('Check Environment') {
            steps {
                sh '''
                    java -version
                    mvn -version
                    docker --version
                '''
            }
        }

        stage('Checkout') {
            steps {
                // No deleteDir(): the workspace is bind-mounted into the container,
                // deleting it from the host breaks every later sh step.
                git branch: 'master',
                    url: "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}"
            }
        }

        stage('Build and Test') {
            steps {
                sh 'ls -ltr'
                sh 'cd "$APP_DIR" && mvn -B clean package'
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                    sh 'cd "$APP_DIR" && mvn -B sonar:sonar -Dsonar.token="$SONAR_AUTH_TOKEN" -Dsonar.host.url="$SONAR_URL"'
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "${IMAGE_REPO}:${BUILD_NUMBER}"
            }

            steps {
                sh 'cd "$APP_DIR" && docker build -t "$DOCKER_IMAGE" .'

                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
                        docker.image(env.DOCKER_IMAGE).push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([string(credentialsId: 'Github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        # Container runs as root, repo was cloned by the jenkins user
                        git config --global --add safe.directory "$WORKSPACE"
                        git config user.email "vishnusharma2k03@gmail.com"
                        git config user.name "Vishnu"

                        # Replace whatever tag is there, not just the first-run placeholder
                        sed -i "s|image: ${IMAGE_REPO}:.*|image: ${IMAGE_REPO}:${BUILD_NUMBER}|" "$MANIFEST"

                        # Fail loudly if the manifest does not use IMAGE_REPO
                        grep -F "${IMAGE_REPO}:${BUILD_NUMBER}" "$MANIFEST" || {
                            echo "ERROR: image line in $MANIFEST does not use ${IMAGE_REPO}"
                            exit 1
                        }

                        git diff -- "$MANIFEST"
                        git add "$MANIFEST"
                        git commit -m "Update deployment image to version ${BUILD_NUMBER} [skip ci]" || echo "Nothing to commit"

                        git push "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" HEAD:master
                    '''
                }
            }
        }
    }

    post {
        always {
            // Files created as root (target/, etc.) would block the host user from cleaning the workspace
            sh 'chown -R "$(stat -c "%u:%g" "$WORKSPACE")" "$WORKSPACE" || true'
        }
    }
}